{
  "name": "@nl-design-system/design-system",
  "author": "Community for NL Design System",
  "description": "Design system based on the NL Design System architecture",
  "license": "EUPL-1.2",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/hall-of-fame.git",
    "directory": "."
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "engines": {
    "//": "Update @types/node when updating this node version",
    "node": ">=24 <=25",
    "pnpm": "^11.4.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.14.0",
    "@nl-design-system/eslint-config": "0.0.1",
    "@nl-design-system/rollup-config-react-component": "1.0.7",
    "@nl-design-system/tsconfig": "1.0.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.14.0",
    "husky": "9.1.7",
    "jsdom": "27.2.0",
    "lint-staged": "15.2.10",
    "markdownlint-cli": "0.49.1",
    "npm-check-updates": "22.2.9",
    "npm-package-json-lint": "8.0.0",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.19",
    "prettier": "3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "sass": "1.101.0",
    "stylelint": "17.14.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-use-logical": "2.1.3",
    "typescript": "5.6.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "clean": "pnpm --recursive --if-present run clean",
    "lint": "npm-run-all --continue-on-error lint:** lint-workspaces",
    "lint:css": "stylelint --allow-empty-input '**/*.{css,scss}'",
    "lint:js": "eslint",
    "lint:md": "markdownlint '**/*.md'",
    "lint:package-json": "npmPkgJsonLint .",
    "lint:package-lock": "pnpm ls --recursive",
    "lint-fix": "npm-run-all --continue-on-error lint-fix:** prettier",
    "lint-fix:css": "stylelint --fix '**/*.{css,scss}'",
    "lint-fix:js": "eslint --fix",
    "lint-fix:md": "markdownlint --fix '**/*.md'",
    "lint-workspaces": "pnpm --recursive --if-present run lint",
    "lint-build": "pnpm --recursive --if-present run lint-build",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "publish:changeset": "changeset publish",
    "start": "http-server packages/storybook/dist/",
    "storybook": "npm-run-all --parallel watch:**",
    "test": "pnpm --recursive --if-present run test",
    "test:coverage": "pnpm --recursive --if-present run test:coverage",
    "test-update": "npm-run-all --sequential clean lint build test",
    "update-patch": "npm-check-updates --configFileName .ncurc.patch.mjs",
    "update-minor": "npm-check-updates --configFileName .ncurc.minor.mjs",
    "update-major": "npm-check-updates --configFileName .ncurc.major.mjs",
    "watch:storybook": "pnpm --filter @nl-design-system/web-components-stencil run build:stencil && pnpm --filter @nl-design-system/design-tokens run build:style-dictionary && pnpm --filter @nl-design-system/storybook run storybook",
    "watch:style-dictionary": "pnpm --filter @nl-design-system/design-tokens run watch:style-dictionary"
  },
  "dependencies": {
    "http-server": "14.1.1"
  }
}
